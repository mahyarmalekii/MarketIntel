# ─── Backend ────────────────────────────────────────────────
# Port the FastAPI server listens on (Railway/Render set PORT automatically)
PORT=2860

# Bind address — use 0.0.0.0 in production, 127.0.0.1 locally
HOST=127.0.0.1

# Fixed authentication token for WebSocket connections.
# Leave blank to auto-generate a random one (fine for local use).
# In production, set this so VITE_API_TOKEN can match it in the frontend.
API_SECRET=

# SQLite database path (relative to backend/)
DATABASE_URL=./data/market.db

# Set to "1" to serve the compiled frontend from ../frontend/dist
# (single-service deployment on Railway/Render)
SERVE_FRONTEND=0

# CORS: comma-separated list of allowed frontend origins
# Use "*" in dev; set your real domain in production
ALLOWED_ORIGINS=*

# ─── Telegram notifications ──────────────────────────────────
# Bot token — @mclawbot_bot (market alerts)
TELEGRAM_BOT_TOKEN=8667375414:AAE4KSlyr_vjPLSGSKczIHjQmQwOt3bPCWo
# Your personal chat ID — run /api/v1/telegram/detect-chat-id to auto-fill this
TELEGRAM_CHAT_ID=

# ─── LLM providers (add any you have) ───────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=

# ─── Frontend ────────────────────────────────────────────────
# URL of the backend API as seen by the browser.
# In dev with vite proxy: leave blank (proxy handles it).
# In production: set to your deployed backend URL.
VITE_BACKEND_URL=

# If API_SECRET is set on the backend, put the same value here
# so the frontend can connect without calling /api/v1/token first.
VITE_API_TOKEN=
