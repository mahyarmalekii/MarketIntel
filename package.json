{
  "name": "market-intel",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm install && npm run dev",
    "dev:backend": "cd backend && python main.py",
    "build": "cd frontend && npm install && npm run build",
    "install:all": "cd frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
